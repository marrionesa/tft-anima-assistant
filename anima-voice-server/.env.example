# ANIMA · Motor de voz local
# Copia este archivo a .env y ajusta lo que necesites.
# El servicio lee las variables del entorno; no carga .env por sí solo,
# así que expórtalas o pásalas al arrancar uvicorn.

# ── Reconocimiento de voz (Whisper) ──────────────────────────────────────
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# cpu | cuda
WHISPER_DEVICE=cpu
# int8 en CPU · float16 en GPU
WHISPER_COMPUTE_TYPE=int8

# ── Síntesis de voz (Piper) ──────────────────────────────────────────────
# Ruta al modelo. Relativa al directorio desde el que arrancas uvicorn.
PIPER_MODEL=models/es_ES-sharvard-medium.onnx
# Índice de hablante dentro del modelo (0, 1, 2...).
PIPER_SPEAKER=1

# ── General ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
